# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database & Auth
MONGO_URI=mongodb://localhost:27017/atelion
JWT_SECRET=your_jwt_secret_here

# Anthropic Claude Agent
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_AGENT_MODEL=claude-3-5-sonnet-20241022
CLAUDE_AGENT_MAX_TURNS=8

# Meta / Facebook Ads Configuration
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_REDIRECT_URI=https://yourdomain.com/oauth/callback
META_GRAPH_VERSION=v21.0

# Official Meta MCP (Model Context Protocol) Server
META_MCP_SERVER_URL=https://mcp.facebook.com/ads
META_MCP_TRANSPORT=STREAMABLE_HTTP

# Google Ads & Cloud Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://yourdomain.com/google/callback
GOOGLE_DEVELOPER_TOKEN=your_google_developer_token_here
GOOGLE_ADS_API_VERSION=v18
DEFAULT_GOOGLE_SHEET_ID=

# Storage
TOKEN_STORAGE_DIR=./tokens
SCRATCH_DIR=./scratch
GCS_BUCKET_NAME=
GCS_PROJECT_ID=
GCS_PRIVATE_KEY=

